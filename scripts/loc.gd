func set_language(next_language: String) -> void:
	if next_language != "zh" and next_language != "en":
		return
	if next_language == language:
		return
	language = next_language
	language_changed.emit()


func toggle_language() -> void:
	set_language("en" if language == "zh" else "zh")


func t(key: String) -> String:
	var table: Dictionary = TEXTS.get(language, TEXTS["en"])
	return str(table.get(key, key))


func tf(key: String, args: Array = []) -> String:
	var text := t(key)
	if args.is_empty():
		return text
	return text % args


func card_name(card_id: int) -> String:
	var card := CardDatabase.get_card(card_id)
	if card.is_empty():
		return "?"
	return str(card.get("name_" + language, card.get("name_en", "?")))


func card_desc(card_id: int) -> String:
	var card := CardDatabase.get_card(card_id)
	if card.is_empty():
		return ""
	var description := str(card.get("desc_" + language, card.get("desc_en", "")))
	if not description.is_empty():
		return description
	var entries: PackedStringArray = []
	for orientation: String in ["upright", "reversed"]:
		var data := CardDatabase.orientation_data(card_id, orientation)
		var text := str(data.get("mark_text_" + language, data.get("mark_text_en", "")))
		if not text.is_empty():
			entries.append("%s\n%s" % [orientation_name(orientation), text])
	return "\n\n".join(entries)


func stat_name(stat: String) -> String:
	match stat:
		"passion":
			return t("stat.passion")
		"intuition":
			return t("stat.intuition")
		"curiosity":
			return t("stat.curiosity")
		"comfort":
			return t("stat.comfort")
	return stat


func orientation_name(orientation: String) -> String:
	match orientation.to_upper():
		"REVERSED":
			return t("orient.reversed")
		_:
			return t("orient.upright")


func phase_name(phase: int) -> String:
	match phase:
		0:
			return t("phase.setup")
		1:
			return t("phase.draw_select")
		2:
			return t("phase.resolve")
		3:
			return t("phase.final")
		4:
			return t("phase.game_over")
	return "?"

func cost_words(cost: Dictionary) -> String:
	var parts: Array[String] = []
	if int(cost.get("w", 0)) > 0:
		parts.append("%d %s" % [int(cost["w"]), t("res.will")])
	if int(cost.get("i", 0)) > 0:
		parts.append("%d %s" % [int(cost["i"]), t("res.intuition")])
	if int(cost.get("h", 0)) > 0:
		parts.append("%d %s" % [int(cost["h"]), t("res.hp")])
	if int(cost.get("d", 0)) > 0:
		parts.append("%d %s" % [int(cost["d"]), t("res.debt")])
	if parts.is_empty():
		return t("log.free")
	return ", ".join(parts)
